# Lapata — environment variables
# Copy to .env.local and fill in values for local development.
# Do not commit real secrets.

# Spotify — Client Credentials flow (https://developer.spotify.com/documentation/web-api/tutorials/client-credentials-flow)
SPOTIFY_CLIENT_ID=replace_with_my_client_id
SPOTIFY_CLIENT_SECRET=replace_with_my_client_secret

# Optional: override Spotify API base (defaults to https://api.spotify.com)
# SPOTIFY_API_BASE=https://api.spotify.com
# Optional: chart cache TTL in seconds (default 600 = 10 min)
# CHART_CACHE_TTL=600
# Optional: Next.js port for frontend (default 3000) is set via -p flag, not env
